{%- liquid
  assign is_coming_soon = false

  if product.tags.size > 0 and product.tags contains 'coming-soon'
    assign is_coming_soon = true
  endif
-%}

{%- if settings.brauz_endpoint != blank and is_coming_soon == false -%}
  {%- liquid
    assign shop_domain = shop.permanent_domain
    assign button_label = 'product.general.find_in_store' | t

    if shop_domain contains 'dev'
      assign shop_domain = 'arms-of-eve.myshopify.com'
    endif
  -%}
  <find-in-store>
    <button
      type="button"
      aria-haspopup="dialog"
      aria-label="{{- button_label -}}"
      class="flex w-full group mt-2 js-find-in-store"
    >
      <span class="button-outlined border-neutral-300 w-full group-hover:border-primary-100 group-hover:bg-primary-100 group-hover:border-r-white">
        {{- button_label -}}
      </span>
      {%- render 'icon' with 'icon-chevron-right',
        class: 'text-neutral-900 size-10 button-outlined border-neutral-300 border-l-0 px-0 group-hover:!border-primary-100 group-hover:!bg-primary-100'
      -%}
    </button>
  </find-in-store>
  <div
    id="brauz-find-in-store-config-product-page"
    data-sd="{{- shop_domain -}}"
    data-cvi="{{- product.first_available_variant.id -}}"
    data-hodv="{{- product.has_only_default_variant -}}"
    class="sr-only"
  ></div>

  {%- render 'atom-script', name: 'module-find-in-store' -%}
{%- endif -%}
